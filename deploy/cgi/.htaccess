# api.naisu.moe 用 (このディレクトリがドキュメントルート)
Options +ExecCGI
AddHandler cgi-script .cgi
DirectoryIndex func_sqrt.cgi

RewriteEngine on
# 無料独自SSL の発行確認 (/.well-known/acme-challenge/) は http のまま通す
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^func_sqrt/?$ func_sqrt.cgi [QSA,L]

<IfModule mod_headers.c>
    # 親 (naisu.moe) の .htaccess の no-cache 設定を上書きする。
    # 計算結果は同じ入力なら変わらないので、成功時は 1 日キャッシュしてよい
    Header unset Pragma
    Header unset Expires
    Header set Cache-Control "public, max-age=86400" "expr=%{REQUEST_STATUS} == 200"
    Header set Cache-Control "no-store" "expr=%{REQUEST_STATUS} != 200"
</IfModule>
ErrorDocument 404 "{\"ok\": false, \"error\": \"not found\"}"
